<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_paper">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/proverb_widget_name" android:textColor="#AA4C32" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/proverb_preview_text"
        android:textColor="#2A211C" android:textSize="18sp" android:fontFamily="serif" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/proverb_preview_meaning"
        android:textColor="#2A211C" android:textSize="14sp" />
</LinearLayout>
