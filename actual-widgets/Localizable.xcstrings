    "Between five and fifteen years, your stroke risk falls to that of someone who never smoked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between five and fifteen years, your stroke risk falls to that of someone who never smoked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş ile on beş yıl arasında inme riskin, hiç sigara içmemiş birininkine iner."
          }
        }
      }
    },
    "Between two and twelve weeks, blood flows better and your lungs work better. Walking and climbing stairs get easier.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between two and twelve weeks, blood flows better and your lungs work better. Walking and climbing stairs get easier."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki ile on iki hafta arasında kan dolaşımın ve akciğerlerin daha iyi çalışır. Yürümek ve merdiven çıkmak kolaylaşır."
          }
        }
      }
    },
