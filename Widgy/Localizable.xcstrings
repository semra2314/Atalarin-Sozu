    },
    "A creator profile is how people find your widgets, so it needs an account." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A creator profile is how people find your widgets, so it needs an account."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasarımcı profili, insanların widget'larını bulma yolu, o yüzden hesap gerekiyor."
          }
        }
      }
    },
    "A live clock whose aurora background follows the light of day. Also sits on your lock screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A live clock whose aurora background follows the light of day. Also sits on your lock screen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurora arka planı günün ışığını takip eden canlı bir saat. Kilit ekranında da durur."
          }
        }
      }
    },
    "A live deep-work timer. Start it, and the countdown follows you to the lock screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A live deep-work timer. Start it, and the countdown follows you to the lock screen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı bir derin çalışma sayacı. Başlat, geri sayım kilit ekranına kadar seninle gelsin."
          }
        }
      }
    },
    "A nudge to drink water, sitting where you already look a hundred times a day." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nudge to drink water, sitting where you already look a hundred times a day."
