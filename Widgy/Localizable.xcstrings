      }
    },
    "A passage a day, from the source you choose: scripture, Stoic philosophy, poetry or proverbs. Always shown with its reference." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A passage a day, from the source you choose: scripture, Stoic philosophy, poetry or proverbs. Always shown with its reference."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin kaynaktan günde bir alıntı: kutsal metin, stoacı felsefe, şiir ya da atasözü. Her zaman kaynağıyla birlikte."
          }
        }
      }
    },
    "A single line to hold you to one thing at a time. Heavy serif on near-black." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single line to hold you to one thing at a time. Heavy serif on near-black."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı anda tek işe bağlı kalman için tek satır. Neredeyse siyah zeminde kalın serif."
          }
        }
      }
    },
    "A slip is part of quitting for most people. Your count starts again from this moment." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slip is part of quitting for most people. Your count starts again from this moment."
