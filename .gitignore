# Per-user Xcode settings: breakpoints, window layout, which scheme is selected.
# Shared schemes (xcshareddata) are deliberately NOT ignored — the Widgy scheme
# lives there, and losing it is what made the widgets disappear from the
# simulator once already.
xcuserdata/
*.xcscmblueprint
*.xccheckout

