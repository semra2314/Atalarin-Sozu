rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────
    // PROVERBS — Herkese okuma açık, yazma sadece Admin SDK
    // ──────────────────────────────────────────────────
    match /proverbs/{proverb} {
      allow read: if true;
      allow write: if false; // Cloud Functions (Admin SDK) bypass eder
    }

    // ──────────────────────────────────────────────────
    // THEMES — Herkese okuma açık, yazma sadece Admin SDK
    // ──────────────────────────────────────────────────
    match /themes/{theme} {
      allow read: if true;
      allow write: if false;
    }

    // ──────────────────────────────────────────────────
    // DAILY_PROVERB — Herkese okuma, yazma Cloud Functions
    // ──────────────────────────────────────────────────
    match /daily_proverb/{date} {
      allow read: if true;
      allow write: if false;
    }

    // ──────────────────────────────────────────────────
    // USERS — Sadece kendi verisine erişebilir
    // ──────────────────────────────────────────────────
    match /users/{userId} {
      // Okuma: sadece kendi dokümanı
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Oluşturma: Auth olmuş kullanıcı kendi belgesini oluşturabilir
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.favorites is list
                    && request.resource.data.purchased_themes is list;

      // Güncelleme: Sadece izin verilen alanlar güncellenebilir
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    // Kullanıcı uid ve is_premium alanını değiştiremesin
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(["uid", "is_premium", "purchased_themes", "created_at"]);

      // Silme: Yok (hesap silme Cloud Functions üzerinden yapılacak)
      allow delete: if false;
    }
  }
}
